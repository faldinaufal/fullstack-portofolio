// Tempora database schema (FSD section 4).
// Prisma models describe tables and relations. Features Prisma cannot express
// (row-level security policies, partial unique indexes, check constraints, grants)
// live in raw SQL inside the migration files.
//
// Columns are added together with the features that use them (expand-only migrations,
// FSD 10.2), so some tables are still a subset of FSD 4.3.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
}

/// A business using Tempora. Not RLS-scoped: the Portal directory lists tenants publicly.
model Tenant {
  id                      String       @id @default(uuid(7)) @db.Uuid
  slug                    String       @unique @db.VarChar(40)
  name                    String       @db.VarChar(100)
  status                  TenantStatus @default(active)
  /// Booking settings (FSD 6.1), configurable by the owner.
  minLeadHours            Int          @default(4) @map("min_lead_hours") @db.SmallInt
  maxAdvanceDays          Int          @default(30) @map("max_advance_days") @db.SmallInt
  cancellationCutoffHours Int          @default(24) @map("cancellation_cutoff_hours") @db.SmallInt
  maxCustomerReschedules  Int          @default(2) @map("max_customer_reschedules") @db.SmallInt
  /// Invoice number prefix, e.g. `LUM` (FSD 4.3, 6.10). Unique across tenants.
  invoicePrefix           String       @unique @map("invoice_prefix") @db.VarChar(6)
  version                 Int          @default(1)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt              DateTime?    @map("archived_at") @db.Timestamptz(3)

  branches      Branch[]
  memberships   Membership[]
  invitations   Invitation[]
  emailMessages EmailMessage[]
  auditLogs     AuditLog[]
  openingHours  BranchOpeningHours[]
  closures      BranchClosure[]
  services      Service[]
  staffServices StaffService[]
  workingHours  StaffWorkingHours[]
  timeOff       StaffTimeOff[]
  customers     TenantCustomer[]
  bookings      Booking[]
  invoices      Invoice[]
  payments      Payment[]
  counters      InvoiceCounter[]
  bookingLinks  BookingAccessToken[]

  @@map("tenants")
}

/// A location of a tenant. RLS: tenant policy.
model Branch {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String    @db.VarChar(100)
  address    String?   @db.VarChar(300)
  phone      String?   @db.VarChar(16)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  memberships  Membership[]
  invitations  Invitation[]
  openingHours BranchOpeningHours[]
  closures     BranchClosure[]
  bookings     Booking[]

  @@index([tenantId])
  @@map("branches")
}

/// Weekly opening hours: one interval per weekday (0 = Sunday). No row = closed that day.
/// Times are wall-clock times in the platform time zone (FSD 4.1). RLS: tenant policy.
model BranchOpeningHours {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  branchId String   @map("branch_id") @db.Uuid
  weekday  Int      @db.SmallInt
  opensAt  DateTime @map("opens_at") @db.Time(0)
  closesAt DateTime @map("closes_at") @db.Time(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, weekday])
  @@index([tenantId])
  @@map("branch_opening_hours")
}

/// Holidays and one-off closures, inclusive date range. RLS: tenant policy.
model BranchClosure {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  reason    String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId, branchId, startsOn])
  @@map("branch_closures")
}

// ---------------------------------------------------------------------------
// Team identity and sessions (Console)
// ---------------------------------------------------------------------------

/// One Console login. Access to businesses comes from memberships. Not tenant-owned.
model TeamAccount {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Stored lowercased (FSD 6.12).
  email             String    @unique @db.VarChar(254)
  passwordHash      String    @map("password_hash")
  name              String    @db.VarChar(100)
  /// Set by the first successful email code: the code proves the address.
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Trusted devices created before this moment are ignored (FSD 6.11).
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships    Membership[]
  sessions       Session[]
  otpChallenges  OtpChallenge[]
  trustedDevices TrustedDevice[]
  authTokens     AuthToken[]

  @@map("team_accounts")
}

/// Platform-wide customer login for the Portal (FSD 4.3). Separate from team accounts: the
/// same email can be a customer and a team member without the two being linked (PRD).
model CustomerAccount {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Stored lowercased (FSD 6.12).
  email             String    @unique @db.VarChar(254)
  passwordHash      String    @map("password_hash")
  name              String    @db.VarChar(100)
  /// E.164 (FSD 6.12).
  phone             String?   @db.VarChar(16)
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions        Session[]
  authTokens      AuthToken[]
  tenantCustomers TenantCustomer[]

  @@map("customer_accounts")
}

enum MembershipRole {
  owner
  manager
  staff

  @@map("membership_role")
}

enum MembershipStatus {
  active
  deactivated

  @@map("membership_status")
}

/// A team account's role in one tenant. RLS: tenant policy + self policy (own memberships).
model Membership {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  teamAccountId String           @map("team_account_id") @db.Uuid
  role          MembershipRole
  /// Null for owners; required for managers and staff (check constraint in SQL).
  branchId      String?          @map("branch_id") @db.Uuid
  status        MembershipStatus @default(active)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  teamAccount        TeamAccount         @relation(fields: [teamAccountId], references: [id])
  branch             Branch?             @relation(fields: [branchId], references: [id])
  sessions           Session[]
  invitationsCreated Invitation[]
  services           StaffService[]
  workingHours       StaffWorkingHours[]
  timeOff            StaffTimeOff[]      @relation("TimeOffOf")
  timeOffCreated     StaffTimeOff[]      @relation("TimeOffCreatedBy")
  bookings           Booking[]

  @@unique([teamAccountId, tenantId])
  @@index([tenantId])
  @@index([branchId])
  @@map("memberships")
}

enum SessionApp {
  portal
  console
  admin

  @@map("session_app")
}

/// Server-side session; the cookie holds a random token, only its HMAC is stored.
model Session {
  id                String     @id @default(uuid(7)) @db.Uuid
  tokenHash         String     @unique @map("token_hash") @db.Char(64)
  app               SessionApp
  teamAccountId     String?    @map("team_account_id") @db.Uuid
  customerAccountId String?    @map("customer_account_id") @db.Uuid
  /// Console sessions are bound to one active membership.
  membershipId      String?    @map("membership_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz(3)
  ip                String?    @db.VarChar(45)
  userAgent         String?    @map("user_agent") @db.VarChar(300)

  teamAccount     TeamAccount?     @relation(fields: [teamAccountId], references: [id])
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  membership      Membership?      @relation(fields: [membershipId], references: [id])

  @@index([teamAccountId])
  @@index([customerAccountId])
  @@index([membershipId])
  @@map("sessions")
}

enum OtpPurpose {
  login
  step_up

  @@map("otp_purpose")
}

/// Created after a correct password. The 6-digit code is never stored, only its HMAC.
model OtpChallenge {
  id            String     @id @default(uuid(7)) @db.Uuid
  purpose       OtpPurpose
  teamAccountId String?    @map("team_account_id") @db.Uuid
  codeHash      String     @map("code_hash") @db.Char(64)
  attempts      Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSentAt    DateTime   @default(now()) @map("last_sent_at") @db.Timestamptz(3)
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime?  @map("consumed_at") @db.Timestamptz(3)
  ip            String?    @db.VarChar(45)

  teamAccount TeamAccount? @relation(fields: [teamAccountId], references: [id])

  @@index([teamAccountId])
  @@map("otp_challenges")
}

/// "Trust this device for 30 days" (Console only). The token lives in its own cookie.
model TrustedDevice {
  id            String    @id @default(uuid(7)) @db.Uuid
  teamAccountId String    @map("team_account_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  label         String    @db.VarChar(120)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  teamAccount TeamAccount @relation(fields: [teamAccountId], references: [id])

  @@index([teamAccountId])
  @@map("trusted_devices")
}

enum AuthTokenPurpose {
  password_reset
  email_verify

  @@map("auth_token_purpose")
}

/// Single-use tokens sent by email (password reset, email verification). Only the HMAC is stored.
model AuthToken {
  id                String           @id @default(uuid(7)) @db.Uuid
  purpose           AuthTokenPurpose
  teamAccountId     String?          @map("team_account_id") @db.Uuid
  customerAccountId String?          @map("customer_account_id") @db.Uuid
  tokenHash         String           @unique @map("token_hash") @db.Char(64)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt            DateTime?        @map("used_at") @db.Timestamptz(3)

  teamAccount     TeamAccount?     @relation(fields: [teamAccountId], references: [id])
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id])

  @@index([teamAccountId])
  @@index([customerAccountId])
  @@map("auth_tokens")
}

/// Invitation to join a tenant (FSD 3.6, 7.4). Valid 7 days; only the token's HMAC is stored.
/// Status is derived: accepted, revoked, expired (time) or pending. RLS: tenant policy.
model Invitation {
  id                    String         @id @default(uuid(7)) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  /// Stored lowercased.
  email                 String         @db.VarChar(254)
  role                  MembershipRole
  /// Null only for owner invitations (assisted onboarding, FSD 3.5).
  branchId              String?        @map("branch_id") @db.Uuid
  tokenHash             String         @unique @map("token_hash") @db.Char(64)
  invitedByMembershipId String?        @map("invited_by_membership_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt             DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt            DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt             DateTime?      @map("revoked_at") @db.Timestamptz(3)

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  branch    Branch?     @relation(fields: [branchId], references: [id])
  invitedBy Membership? @relation(fields: [invitedByMembershipId], references: [id])

  @@index([tenantId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Catalogue and schedules
// ---------------------------------------------------------------------------

/// Tenant-wide service catalogue (FSD 4.3). Bookings copy name, duration, buffer and price,
/// so later changes never alter past bookings. RLS: tenant policy.
model Service {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String    @db.VarChar(100)
  description     String?   @db.VarChar(500)
  durationMinutes Int       @map("duration_minutes") @db.SmallInt
  bufferMinutes   Int       @default(0) @map("buffer_minutes") @db.SmallInt
  /// Integer cents, USD (FSD 4.1).
  priceCents      Int       @map("price_cents")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  staffServices StaffService[]
  bookings      Booking[]

  @@index([tenantId])
  @@map("services")
}

/// Which therapist performs which service. RLS: tenant policy.
model StaffService {
  tenantId     String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  serviceId    String @map("service_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])
  service    Service    @relation(fields: [serviceId], references: [id])

  @@id([membershipId, serviceId])
  @@index([tenantId])
  @@index([serviceId])
  @@map("staff_services")
}

/// Weekly working hours: one interval per weekday, within the branch opening hours
/// (checked by the API). RLS: tenant policy.
model StaffWorkingHours {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  weekday      Int      @db.SmallInt
  startsAt     DateTime @map("starts_at") @db.Time(0)
  endsAt       DateTime @map("ends_at") @db.Time(0)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  @@unique([membershipId, weekday])
  @@index([tenantId])
  @@map("staff_working_hours")
}

/// Time off blocks a therapist's availability (FSD 6.2 rule 5). RLS: tenant policy.
model StaffTimeOff {
  id                    String   @id @default(uuid(7)) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  membershipId          String   @map("membership_id") @db.Uuid
  startsAt              DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime @map("ends_at") @db.Timestamptz(3)
  reason                String?  @db.VarChar(500)
  createdByMembershipId String?  @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  membership Membership  @relation("TimeOffOf", fields: [membershipId], references: [id])
  createdBy  Membership? @relation("TimeOffCreatedBy", fields: [createdByMembershipId], references: [id])

  @@index([tenantId, membershipId, startsAt])
  @@map("staff_time_off")
}

// ---------------------------------------------------------------------------
// Customers, bookings and billing
// ---------------------------------------------------------------------------

/// A tenant's view of a customer (FSD 4.3): a tenant never sees the customer's records at
/// other tenants. Guests have no account. RLS: tenant policy + customer policy (read).
model TenantCustomer {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  customerAccountId String?  @map("customer_account_id") @db.Uuid
  /// Stored lowercased.
  email             String   @db.VarChar(254)
  name              String   @db.VarChar(100)
  phone             String?  @db.VarChar(16)
  firstBookedAt     DateTime @default(now()) @map("first_booked_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  bookings        Booking[]

  @@unique([tenantId, email])
  @@index([customerAccountId])
  @@map("tenant_customers")
}

enum BookingStatus {
  pending_payment
  confirmed
  cancelled
  expired
  completed
  no_show

  @@map("booking_status")
}

/// A booked session (FSD 4.3, 7.1). Copies the service's name, duration, buffer and price, so
/// later catalogue changes never alter it. Double booking is prevented by an exclusion
/// constraint in SQL. RLS: tenant policy + customer policy (read).
model Booking {
  id                      String        @id @default(uuid(7)) @db.Uuid
  tenantId                String        @map("tenant_id") @db.Uuid
  branchId                String        @map("branch_id") @db.Uuid
  serviceId               String        @map("service_id") @db.Uuid
  staffMembershipId       String        @map("staff_membership_id") @db.Uuid
  tenantCustomerId        String        @map("tenant_customer_id") @db.Uuid
  startsAt                DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime      @map("ends_at") @db.Timestamptz(3)
  /// `ends_at` + buffer: the range the therapist is unavailable.
  blockedUntil            DateTime      @map("blocked_until") @db.Timestamptz(3)
  status                  BookingStatus @default(pending_payment)
  holdExpiresAt           DateTime?     @map("hold_expires_at") @db.Timestamptz(3)
  serviceName             String        @map("service_name") @db.VarChar(100)
  durationMinutes         Int           @map("duration_minutes") @db.SmallInt
  bufferMinutes           Int           @map("buffer_minutes") @db.SmallInt
  priceCents              Int           @map("price_cents")
  customerNotes           String?       @map("customer_notes") @db.VarChar(500)
  customerRescheduleCount Int           @default(0) @map("customer_reschedule_count") @db.SmallInt
  cancelReason            String?       @map("cancel_reason") @db.VarChar(500)
  cancelledAt             DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  /// `customer`, `guest`, `owner` or `manager` (FSD 6.7).
  cancelledByType         String?       @map("cancelled_by_type") @db.VarChar(10)
  /// Customer account or membership that cancelled; null for a guest.
  cancelledById           String?       @map("cancelled_by_id") @db.Uuid
  version                 Int           @default(1)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  branch         Branch               @relation(fields: [branchId], references: [id])
  service        Service              @relation(fields: [serviceId], references: [id])
  staff          Membership           @relation(fields: [staffMembershipId], references: [id])
  tenantCustomer TenantCustomer       @relation(fields: [tenantCustomerId], references: [id])
  invoice        Invoice?
  accessTokens   BookingAccessToken[]
  emails         EmailMessage[]

  @@index([tenantId, startsAt])
  @@index([staffMembershipId, startsAt])
  @@index([tenantCustomerId])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

/// Access to one booking without a login: the guest "manage booking" link, and the token the
/// booking browser keeps for the payment pages (FSD 4.3, 5.3). Only the HMAC is stored.
/// RLS: tenant policy + the one row matching `app.booking_token_hash` (read).
model BookingAccessToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  bookingId String    @map("booking_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("booking_access_tokens")
}

enum InvoiceStatus {
  open
  paid
  void

  @@map("invoice_status")
}

/// One invoice per booking, numbered `<prefix>-<year>-<6 digits>` without gaps (FSD 6.10).
/// RLS: tenant policy + customer policy (read).
model Invoice {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  bookingId   String        @unique @map("booking_id") @db.Uuid
  number      String        @db.VarChar(24)
  status      InvoiceStatus @default(open)
  amountCents Int           @map("amount_cents")
  currency    String        @default("usd") @db.Char(3)
  issuedAt    DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  paidAt      DateTime?     @map("paid_at") @db.Timestamptz(3)
  voidedAt    DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason  String?       @map("void_reason") @db.VarChar(200)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  booking  Booking   @relation(fields: [bookingId], references: [id])
  payments Payment[]

  @@unique([tenantId, number])
  @@map("invoices")
}

/// Next invoice number per tenant and year. Taking it locks the row, so numbers are
/// sequential without gaps even under concurrency (a rolled-back booking returns its number).
model InvoiceCounter {
  tenantId  String @map("tenant_id") @db.Uuid
  year      Int    @db.SmallInt
  nextValue Int    @map("next_value")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, year])
  @@map("invoice_counters")
}

enum PaymentStatus {
  pending
  succeeded
  expired
  failed
  needs_attention

  @@map("payment_status")
}

/// One row per Checkout attempt (FSD 4.3, 7.3). RLS: tenant policy + customer policy (read).
model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  /// `stripe`, or `demo` when the app runs without Stripe keys.
  provider          String        @db.VarChar(10)
  checkoutSessionId String        @unique @map("checkout_session_id") @db.VarChar(255)
  checkoutUrl       String        @map("checkout_url") @db.VarChar(2000)
  paymentIntentId   String?       @map("payment_intent_id") @db.VarChar(255)
  status            PaymentStatus @default(pending)
  amountCents       Int           @map("amount_cents")
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

/// Webhook events already processed (FSD 4.3 `stripe_events`). Inserting a known ID fails,
/// which makes webhook processing idempotent. Platform-level, no RLS.
model StripeEvent {
  id          String    @id @db.VarChar(255)
  type        String    @db.VarChar(100)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@map("stripe_events")
}

/// Stored responses of requests sent with an `Idempotency-Key` (FSD 4.3, 5.1). Kept 24 h.
model IdempotencyKey {
  key            String   @db.Uuid
  /// Who sent it (customer account, or the guest's email), so keys of different people
  /// never collide.
  subject        String   @db.VarChar(300)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int      @map("response_status") @db.SmallInt
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([key, subject])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

enum AuditActorType {
  team_member
  platform_admin
  customer
  system

  @@map("audit_actor_type")
}

/// Append-only record of every state change (FSD 4.3, 9.2). The API's database role can
/// insert and read but never update or delete rows. RLS: tenant policy.
model AuditLog {
  id         String         @id @default(uuid(7)) @db.Uuid
  /// Null for platform-level events.
  tenantId   String?        @map("tenant_id") @db.Uuid
  /// Set for branch-scoped events, so managers see only their branch's entries.
  branchId   String?        @map("branch_id") @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  /// Name at the time of the action, kept even if the actor changes later.
  actorLabel String         @map("actor_label") @db.VarChar(150)
  action     String         @db.VarChar(80)
  entityType String         @map("entity_type") @db.VarChar(40)
  entityId   String?        @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  reason     String?        @db.VarChar(500)
  requestId  String?        @map("request_id") @db.VarChar(128)
  ip         String?        @db.VarChar(45)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

enum EmailStatus {
  queued
  sent
  failed
  /// A booking email whose booking changed before it was due (FSD 6.5).
  skipped

  @@map("email_status")
}

/// Transactional outbox and delivery log in one table. The API inserts a row in the same
/// transaction as the change that caused it; the worker sends it and records the result.
/// `payload` holds the template data (it can contain a code or link) and is erased once the
/// message is sent or has finally failed. RLS: tenant policy; platform rows have no tenant.
model EmailMessage {
  id                String      @id @default(uuid(7)) @db.Uuid
  tenantId          String?     @map("tenant_id") @db.Uuid
  toEmail           String      @map("to_email") @db.VarChar(254)
  template          String      @db.VarChar(60)
  payload           Json?
  status            EmailStatus @default(queued)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError         String?     @map("last_error") @db.VarChar(500)
  providerMessageId String?     @map("provider_message_id") @db.VarChar(200)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(3)
  /// Scheduled booking emails (reminder): sent only while the booking is still `confirmed`
  /// and still starts at `bookingStartsAt`, otherwise `skipped` (FSD 6.5).
  bookingId         String?     @map("booking_id") @db.Uuid
  bookingStartsAt   DateTime?   @map("booking_starts_at") @db.Timestamptz(3)

  tenant  Tenant?  @relation(fields: [tenantId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([tenantId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([bookingId])
  @@map("email_messages")
}

/// Rate-limit counter shared by every API container (FSD 8.2). One row per counted event;
/// the key is an HMAC, so emails and IP addresses are not stored in clear.
model RateLimitHit {
  id        BigInt   @id @default(autoincrement())
  bucket    String   @db.VarChar(40)
  keyHash   String   @map("key_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([bucket, keyHash, createdAt])
  @@map("rate_limit_hits")
}
