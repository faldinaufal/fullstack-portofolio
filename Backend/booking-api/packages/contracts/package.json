{
  "name": "@tempora/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "API contract shared by the Tempora API and apps: Zod schemas and TypeScript types.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
