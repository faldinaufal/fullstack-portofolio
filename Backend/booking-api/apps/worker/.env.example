NODE_ENV=development
LOG_LEVEL=info

# Database: jobs role (owns only the pgboss schema)
JOBS_DATABASE_URL=postgresql://tempora_jobs:<password>@localhost:5432/tempora

# Email: Mailpit locally (web inbox at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Tempora <no-reply@tempora.local>

# Public demo (FSD 10.3): emails to @DEMO_EMAIL_DOMAIN are stored for the demo inbox
# instead of sent; every other address still goes to SMTP.
# DEMO_MODE=true
# DEMO_EMAIL_DOMAIN=veloria.test
