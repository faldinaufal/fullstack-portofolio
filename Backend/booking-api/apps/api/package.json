{
  "name": "@tempora/api",
  "version": "0.0.0",
  "private": true,
  "description": "Tempora REST API (Fastify).",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/create-platform-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/swagger": "9.9.5",
    "@fastify/swagger-ui": "6.1.4",
    "@node-rs/argon2": "2.2.2",
    "@tempora/contracts": "workspace:*",
    "@tempora/db": "workspace:*",
    "close-with-grace": "2.5.0",
    "date-fns": "4.4.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "stripe": "23.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
