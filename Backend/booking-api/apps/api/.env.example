# Runtime
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=4000
APP_VERSION=dev

# Database: application role (row-level security enforced)
DATABASE_URL=postgresql://tempora_app:<password>@localhost:5432/tempora

# App origins allowed by CORS (and used for links in emails later)
PORTAL_URL=http://localhost:3000
CONSOLE_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# Secret for hashing session, code and link tokens (HMAC). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TOKEN_HASH_SECRET=
# Production only: parent domain shared by the apps and the API, e.g. .example.com
# COOKIE_DOMAIN=.example.com
# Set to true behind the hosting proxy so rate limits see the real client IP
TRUST_PROXY=false
# Platform time zone (IANA): opening hours and slots are wall-clock times in it
APP_TIME_ZONE=America/New_York

# Payments. Leave both empty for demo payments: a demo checkout page in the Portal and
# signed demo webhooks, no Stripe account needed. For Stripe test mode set both
# (test keys only: sk_test_… and the whsec_… of your webhook endpoint or `stripe listen`).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Object storage for logos and cover photos (FSD 6.15). Leave all unset to run without
# uploads (pages show initials). With `docker compose up storage` running locally:
# S3_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# S3_BUCKET=tempora-files
# S3_ACCESS_KEY_ID=<same as in the root .env>
# S3_SECRET_ACCESS_KEY=<same as in the root .env>
# S3_PUBLIC_BASE_URL=http://localhost:8333/tempora-files
# Only when browsers reach storage at another address than the API:
# S3_UPLOAD_ENDPOINT=

# Public demo (FSD 10.3): GET /v1/public/demo-inbox lists the emails sent to demo addresses.
# Turn on together with the worker's DEMO_MODE; the domain is the seed's DEMO_EMAIL_DOMAIN.
# DEMO_MODE=true
# DEMO_EMAIL_DOMAIN=veloria.test
