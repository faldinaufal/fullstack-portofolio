# Runtime
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=4000
APP_VERSION=dev

# Database: application role (row-level security enforced)
DATABASE_URL=postgresql://tempora_app:<password>@localhost:5432/tempora

# App origins allowed by CORS (and used for links in emails later)
PORTAL_URL=http://localhost:3000
CONSOLE_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
