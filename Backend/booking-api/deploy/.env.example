# Production settings for compose.yml (FSD 10.4). On the server:
#   cp .env.example .env && chmod 600 .env   then fill in every value.
# Generate each password and secret with:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-40

# The project's host: the Portal answers here, the rest on console., admin., api., files.
DOMAIN=
# Let's Encrypt sends certificate notices here.
ACME_EMAIL=

# Images: ghcr.io/<IMAGE_OWNER>/tempora-<service>:<IMAGE_TAG>.
# deploy.sh sets IMAGE_TAG to the deployed commit SHA after each deploy, so commands run by
# hand use the running images. `latest` (the last image built from main) is only the start.
IMAGE_OWNER=
IMAGE_TAG=latest

# Database roles (owner, API, worker)
POSTGRES_PASSWORD=
TEMPORA_APP_PASSWORD=
TEMPORA_JOBS_PASSWORD=

# At least 32 characters
TOKEN_HASH_SECRET=

# Object storage key pair (any two random strings)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Must match the TEMPORA_APP_TIME_ZONE the apps were built with (GitHub variable)
APP_TIME_ZONE=America/New_York
