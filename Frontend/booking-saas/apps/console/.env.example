# Tempora API origin (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Platform time zone (IANA), the same as the API's APP_TIME_ZONE
NEXT_PUBLIC_APP_TIME_ZONE=America/New_York

# Public demo (FSD 10.3): demo accounts on the login page. Same domain and password as the seed.
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_DEMO_EMAIL_DOMAIN=veloria.test
# NEXT_PUBLIC_DEMO_PASSWORD=tempora-demo-2026
# Portal origin, for the link to its demo inbox
# NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
