# Local passwords for docker compose (copy to .env and change them).
# Used only by the local PostgreSQL container; never reuse them anywhere else.
POSTGRES_PASSWORD=
TEMPORA_APP_PASSWORD=
TEMPORA_JOBS_PASSWORD=

# Secret for hashing session, code and link tokens (at least 32 characters). Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TOKEN_HASH_SECRET=

# Key pair for the local object storage container (images). Any two random strings, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(16).toString('hex'))"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
